// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  KYC // wait user to complete kyc
  PENDING // wait email verification
  INACTIVE
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique // to use in app
  name      String?
  phone     String?
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  sso       SSO[]

  @@map("users")
}

enum JobStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

model Job {
  id          String    @id @default(uuid())
  title       String
  description String?
  company     String?
  location    String?
  salary      String?
  type        String?
  status      JobStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("jobs")
}

enum SSOProvider {
  GOOGLE
  CUSTOM
}

model SSO {
  id             String      @id @default(uuid())
  provider       SSOProvider @default(GOOGLE)
  providerId     String      @unique
  providerEmail  String?
  providerName   String?
  providerAvatar String?
  meta           Json?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  User           User?       @relation(fields: [userId], references: [id])
  userId         String?

  @@map("sso")
}

model Logs {
  id        String   @id @default(uuid())
  userId    String   @default("system")
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@map("logs")
}
